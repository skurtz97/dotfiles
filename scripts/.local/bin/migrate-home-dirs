#!/usr/bin/env bash
# shellcheck shell=bash
#
# migrate-home-dirs - move per-tool dirs out of $HOME and into ~/.local:
#   ~/.go          -> $XDG_DATA_HOME/go          (binaries -> ~/.local/bin)
#   ~/.bun         -> $XDG_DATA_HOME/bun         (absolute symlinks rewritten)
#   ~/.npm-global  -> reinstall globals with prefix ~/.local
#   ~/.opencode    -> reinstall as npm package opencode-ai
#   ~/.npm         -> removed (cache; now $XDG_CACHE_HOME/npm)
#   ~/.micromamba  -> $XDG_DATA_HOME/micromamba  (envs recreated from specs)
#   ~/.lmstudio    -> removed with --remove-lmstudio

set -euo pipefail

readonly DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
readonly LOCAL="$HOME/.local"
readonly BIN="$LOCAL/bin"

DRY_RUN=0
VERBOSE=0
RM_LMSTUDIO=0

usage() {
    cat <<EOF
Usage: ${0##*/} [OPTIONS]

Options:
  -n, --dry-run          Show what would be done
  -v, --verbose          Print each command
      --remove-lmstudio  Also delete ~/.lmstudio (models included)
  -h, --help             Show this help and exit
EOF
}

log()  { printf '%s\n' "$*"; }
vlog() { if (( VERBOSE )); then printf '%s\n' "$*"; fi; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }

run() {
    if (( DRY_RUN )); then
        log "[dry-run] $*"
        return 0
    fi
    vlog "+ $*"
    "$@"
}

remove_dir() {
    if [[ -d "$1" ]]; then
        run rm -rf -- "$1"
        log "removed $1"
    fi
}

parse_args() {
    while (( $# > 0 )); do
        case "$1" in
            -n|--dry-run)      DRY_RUN=1 ;;
            -v|--verbose)      VERBOSE=1 ;;
            --remove-lmstudio) RM_LMSTUDIO=1 ;;
            -h|--help)         usage; exit 0 ;;
            *)                 usage >&2; die "unknown option: $1" ;;
        esac
        shift
    done
}

move_dir() {
    local src="$1" dst="$2"
    if [[ ! -e "$src" ]]; then
        vlog "skip: $src not found"
        return 0
    fi
    [[ ! -e "$dst" ]] || die "$dst already exists; refusing to overwrite"
    run mkdir -p "${dst%/*}"
    run mv -- "$src" "$dst"
    log "moved $src -> $dst"
}

migrate_go() {
    local old="$HOME/.go" f name
    if [[ -d "$old/bin" ]]; then
        run mkdir -p "$BIN"
        for f in "$old"/bin/*; do
            [[ -e "$f" ]] || continue
            name="${f##*/}"
            if [[ -e "$BIN/$name" ]]; then
                log "warn: $BIN/$name exists; leaving $name in Go bin dir"
                continue
            fi
            run mv -- "$f" "$BIN/$name"
        done
    fi
    move_dir "$old" "$DATA/go"
}

migrate_bun() {
    local old="$HOME/.bun" new="$DATA/bun" link target
    move_dir "$old" "$new"
    if (( DRY_RUN )) || [[ ! -d "$new/bin" ]]; then
        return 0
    fi
    # Global package shims are absolute symlinks into the old prefix
    for link in "$new"/bin/*; do
        [[ -L "$link" ]] || continue
        target="$(readlink -- "$link")"
        [[ "$target" == "$old"/* ]] || continue
        ln -sfn -- "$new${target#"$old"}" "$link"
        vlog "relinked ${link##*/}"
    done
}

migrate_npm() {
    local old="$HOME/.npm-global" mods d
    local -a pkgs=()

    if ! command -v npm >/dev/null 2>&1; then
        log "warn: npm not found; skipping ~/.npm-global and ~/.opencode"
        return 0
    fi

    mods="$old/lib/node_modules"
    if [[ -d "$mods" ]]; then
        # Top-level packages, including @scope/name; skip npm itself
        for d in "$mods"/*/ "$mods"/@*/*/; do
            [[ -d "$d" ]] || continue
            d="${d%/}"
            d="${d#"$mods/"}"
            [[ "$d" != @* || "$d" == @*/* ]] || continue
            [[ "$d" != npm ]] || continue
            pkgs+=("$d")
        done
    fi
    if [[ -d "$HOME/.opencode" && " ${pkgs[*]} " != *" opencode-ai "* ]]; then
        pkgs+=("opencode-ai")
    fi

    if (( ${#pkgs[@]} > 0 )); then
        log "installing into $LOCAL: ${pkgs[*]}"
        run npm install -g --prefix "$LOCAL" "${pkgs[@]}"
    fi

    remove_dir "$old"
    remove_dir "$HOME/.opencode"
    remove_dir "$HOME/.npm"

    if [[ -f "$HOME/.npmrc" ]] && grep -q '^[[:space:]]*prefix' "$HOME/.npmrc"; then
        log "warn: ~/.npmrc sets prefix; delete that line (env var wins, but it's stale)"
    fi
}

migrate_mamba() {
    local old="$HOME/.micromamba" new="$DATA/micromamba"
    local mamba="$BIN/micromamba" specs env name f
    local -a names=()

    if [[ ! -d "$old" ]]; then
        vlog "skip: $old not found"
        return 0
    fi
    [[ ! -e "$new" ]] || die "$new already exists; refusing to overwrite"
    [[ -x "$mamba" ]] || die "micromamba not found at $mamba"

    # 1. Export explicit specs (kept in the new root for reference)
    specs="$new/env-specs"
    run mkdir -p "$specs"
    for env in "$old"/envs/*/; do
        [[ -d "$env" ]] || continue
        name="$(basename -- "$env")"
        names+=("$name")
        if (( DRY_RUN )); then
            log "[dry-run] export $name -> $specs/$name.txt"
        else
            vlog "+ micromamba env export -p $env --explicit > $specs/$name.txt"
            "$mamba" env export -p "$env" --explicit > "$specs/$name.txt"
        fi
    done

    # 2. Package cache is relocatable; move it so recreation is mostly offline
    if [[ -d "$old/pkgs" ]]; then
        run mv -- "$old/pkgs" "$new/pkgs"
    fi

    # 3. Recreate each env under the new root
    for name in "${names[@]}"; do
        f="$specs/$name.txt"
        run "$mamba" create -y -r "$new" -n "$name" -f "$f"
        log "recreated env $name"
    done

    remove_dir "$old"
}

main() {
    parse_args "$@"
    migrate_go
    migrate_bun
    migrate_npm
    migrate_mamba
    if (( RM_LMSTUDIO )); then
        remove_dir "$HOME/.lmstudio"
    fi
}

main "$@"
