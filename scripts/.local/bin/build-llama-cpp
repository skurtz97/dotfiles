#!/usr/bin/env bash
### shellcheck shell=bash
### build-llama-cpp: Native llama.cpp build (Clang + optional HIP/ROCm).
###
### Environment:
###   LLAMA_SRC              source checkout      (default: ~/src/llama.cpp)
###   LLAMA_BUILD_DIR        CMake build dir      (default: $LLAMA_SRC/build)
###   LLAMA_PREFIX           install prefix       (default: ~/.local)
###   LLAMA_BACKEND          auto|hip|cpu         (default: auto)
###   LLAMA_GPU_TARGETS      ROCm target          (default: detected with rocminfo)
###   LLAMA_JOBS             parallel jobs        (default: nproc)
###   LLAMA_UPDATE           0 to skip git update (default: 1)
###   LLAMA_CLEAN            1 to wipe build dir  (default: 0)
###   LLAMA_PYTHON           0 to skip GGUF Python env (default: 1)
###   LLAMA_VENV             Python venv path     (default: $LLAMA_SRC/.venv)
###   LLAMA_PYTHON_VERSION   venv Python version  (default: 3.12)
set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'
if [ ! -t 1 ]; then
    GREEN='' YELLOW='' RED='' NC=''
fi

info() { printf "%b[*]%b %s\n" "$GREEN" "$NC" "$*"; }
warn() { printf "%b[!]%b %s\n" "$YELLOW" "$NC" "$*" >&2; }
die() { printf "%b[!]%b %s\n" "$RED" "$NC" "$*" >&2; exit 1; }

SRC_DIR="${LLAMA_SRC:-$HOME/src/llama.cpp}"
BUILD_DIR="${LLAMA_BUILD_DIR:-$SRC_DIR/build}"
PREFIX="${LLAMA_PREFIX:-$HOME/.local}"
BACKEND="${LLAMA_BACKEND:-auto}"
JOBS="${LLAMA_JOBS:-$(nproc 2>/dev/null || printf '1')}"
UPDATE="${LLAMA_UPDATE:-1}"
CLEAN="${LLAMA_CLEAN:-0}"
PYTHON_DEPS="${LLAMA_PYTHON:-1}"
VENV_DIR="${LLAMA_VENV:-$SRC_DIR/.venv}"
PYTHON_VERSION="${LLAMA_PYTHON_VERSION:-3.12}"
CC_BIN="${LLAMA_CC:-clang}"
CXX_BIN="${LLAMA_CXX:-clang++}"
ROCM_PREFIX="${ROCM_PATH:-/usr}"

find_hip_clang() {
    local candidate
    for candidate in \
        "$ROCM_PREFIX/lib64/rocm/llvm/bin/clang++" \
        "$ROCM_PREFIX/llvm/bin/clang++" \
        "/opt/rocm/llvm/bin/clang++"; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 0
}

detect_gpu_target() {
    command -v rocminfo >/dev/null 2>&1 || return 0
    rocminfo 2>/dev/null | grep -o 'gfx[0-9][0-9a-z]*' | head -n 1 || true
}

find_hip_device_lib_path() {
    local bitcode_dir
    for bitcode_dir in "$ROCM_PREFIX"/lib64/rocm/llvm/lib/clang/*/lib/amdgcn/bitcode \
        "$ROCM_PREFIX"/llvm/lib/clang/*/lib/amdgcn/bitcode; do
        if [ -f "$bitcode_dir/oclc_abi_version_400.bc" ]; then
            printf '%s\n' "$bitcode_dir"
            return 0
        fi
    done
    return 0
}

for cmd in git cmake "$CC_BIN" "$CXX_BIN"; do
    command -v "$cmd" >/dev/null 2>&1 || die "Missing required command: $cmd"
done
CC_PATH=$(command -v "$CC_BIN")
CXX_PATH=$(command -v "$CXX_BIN")
if ! command -v ninja >/dev/null 2>&1; then
    warn "ninja not found; falling back to the default CMake generator."
fi

hip_clang=$(find_hip_clang)
hip_device_lib=$(find_hip_device_lib_path)
gpu_target="${LLAMA_GPU_TARGETS:-$(detect_gpu_target)}"

case "$BACKEND" in
auto)
    if [ -n "$hip_clang" ] && [ -n "$gpu_target" ]; then
        BACKEND=hip
    else
        BACKEND=cpu
    fi
    ;;
hip)
    [ -n "$hip_clang" ] || die "HIP build requested, but ROCm Clang was not found (try setup-ai-deps)."
    [ -n "$gpu_target" ] || die "HIP build requested, but no GPU target was detected. Set LLAMA_GPU_TARGETS=gfx1201."
    ;;
cpu) ;;
*)
    die "Unknown LLAMA_BACKEND='$BACKEND' (expected auto, hip, or cpu)."
    ;;
esac

if [ "$BACKEND" = "hip" ]; then
    info "Backend: HIP ($gpu_target) + native CPU"
    export ROCM_PATH="$ROCM_PREFIX"
    export HIP_PATH="${HIP_PATH:-$ROCM_PREFIX}"
    export HIPCXX="$hip_clang"
    if [ -n "$hip_device_lib" ]; then
        export HIP_DEVICE_LIB_PATH="$hip_device_lib"
    fi
else
    info "Backend: native CPU"
fi

# Update or clone the source tree without throwing away local work.
if [ -d "$SRC_DIR/.git" ]; then
    if [ "$UPDATE" = "1" ]; then
        if [ -n "$(git -C "$SRC_DIR" status --porcelain)" ]; then
            warn "Source tree is dirty; skipping update: $SRC_DIR"
        else
            info "Updating llama.cpp..."
            git -C "$SRC_DIR" pull --ff-only
        fi
    fi
else
    info "Cloning llama.cpp into $SRC_DIR..."
    mkdir -p "$(dirname "$SRC_DIR")"
    git clone https://github.com/ggml-org/llama.cpp.git "$SRC_DIR"
fi

if [ "$CLEAN" = "1" ] && [ -d "$BUILD_DIR" ]; then
    info "Removing build directory: $BUILD_DIR"
    rm -rf "$BUILD_DIR"
fi

# Reconfiguring an existing cache with a different compiler/backend confuses
# CMake, so start fresh when those settings changed.
cache="$BUILD_DIR/CMakeCache.txt"
if [ -f "$cache" ]; then
    cached_cxx=$(sed -n 's/^CMAKE_CXX_COMPILER:[^=]*=//p' "$cache" | head -n 1)
    case "$cached_cxx" in
    */*) ;;
    "") ;;
    *) cached_cxx=$(command -v "$cached_cxx" 2>/dev/null || printf '%s' "$cached_cxx") ;;
    esac
    cached_hip_compiler=$(sed -n 's/^CMAKE_HIP_COMPILER:[^=]*=//p' "$cache" | head -n 1)
    cached_hip=$(sed -n 's/^GGML_HIP:BOOL=//p' "$cache" | head -n 1)
    want_hip=OFF
    [ "$BACKEND" = "hip" ] && want_hip=ON
    if { [ -n "$cached_cxx" ] && [ "$cached_cxx" != "$CXX_PATH" ]; } ||
        { [ "$want_hip" = "ON" ] && [ -n "$cached_hip_compiler" ] && [ "$cached_hip_compiler" != "$hip_clang" ]; } ||
        { [ -n "$cached_hip" ] && [ "$cached_hip" != "$want_hip" ]; }; then
        warn "Compiler/backend changed; removing stale build directory."
        rm -rf "$BUILD_DIR"
    fi
fi

cmake_args=(
    -S "$SRC_DIR"
    -B "$BUILD_DIR"
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_C_COMPILER="$CC_PATH"
    -DCMAKE_CXX_COMPILER="$CXX_PATH"
    -DCMAKE_INSTALL_PREFIX="$PREFIX"
    -DLLAMA_BUILD_TESTS=OFF
    -DLLAMA_BUILD_EXAMPLES=OFF
    -DLLAMA_BUILD_TOOLS=ON
    -DLLAMA_BUILD_SERVER=ON
    -DLLAMA_OPENSSL=ON
    -DGGML_NATIVE=ON
    -DBUILD_SHARED_LIBS=OFF
    -DGGML_BACKEND_DL=OFF
)
if command -v ninja >/dev/null 2>&1; then
    cmake_args+=(-G Ninja)
fi
if command -v ccache >/dev/null 2>&1; then
    cmake_args+=(-DGGML_CCACHE=ON)
else
    cmake_args+=(-DGGML_CCACHE=OFF)
fi

if [ "$BACKEND" = "hip" ]; then
    cmake_args+=(
        -DGGML_HIP=ON
        -DCMAKE_HIP_COMPILER="$hip_clang"
        -DGPU_TARGETS="$gpu_target"
        -DCMAKE_HIP_ARCHITECTURES="$gpu_target"
        -DAMDGPU_TARGETS="$gpu_target"
    )
else
    cmake_args+=(-DGGML_HIP=OFF)
fi

info "Configuring (Clang: $CC_PATH / $CXX_PATH)..."
cmake "${cmake_args[@]}"

info "Building with $JOBS jobs..."
cmake --build "$BUILD_DIR" --parallel "$JOBS"

info "Installing to $PREFIX..."
cmake --install "$BUILD_DIR" --prefix "$PREFIX"

# The GGUF conversion tooling is Python. Keep it in a dedicated venv so the
# system Python is untouched.
if [ "$PYTHON_DEPS" = "1" ]; then
    info "Preparing Python GGUF conversion environment..."
    if command -v uv >/dev/null 2>&1; then
        if [ ! -x "$VENV_DIR/bin/python" ]; then
            if ! uv venv --python "$PYTHON_VERSION" "$VENV_DIR"; then
                warn "Could not create venv at $VENV_DIR; GGUF conversion deps were not installed."
            fi
        fi
        if [ -x "$VENV_DIR/bin/python" ]; then
            if ! uv pip install --python "$VENV_DIR/bin/python" \
                --index-strategy unsafe-best-match \
                -r "$SRC_DIR/requirements.txt"; then
                warn "Could not install llama.cpp Python requirements into $VENV_DIR."
            fi
        fi
    elif command -v python3 >/dev/null 2>&1; then
        if [ ! -x "$VENV_DIR/bin/python" ]; then
            python3 -m venv "$VENV_DIR" || warn "Could not create venv at $VENV_DIR."
        fi
        if [ -x "$VENV_DIR/bin/python" ]; then
            if ! "$VENV_DIR/bin/python" -m pip install --upgrade pip; then
                warn "Could not upgrade pip in $VENV_DIR."
            fi
            if ! "$VENV_DIR/bin/python" -m pip install -r "$SRC_DIR/requirements.txt"; then
                warn "Could not install llama.cpp Python requirements into $VENV_DIR."
            fi
        fi
    else
        warn "Neither uv nor python3 found; GGUF conversion deps were not installed."
    fi
fi

for bin in llama-server llama-cli llama-quantize llama-bench llama-gguf-split; do
    [ -x "$PREFIX/bin/$bin" ] || die "Expected executable not installed: $PREFIX/bin/$bin"
done

info "Build complete."
printf '  llama-server: %s\n' "$PREFIX/bin/llama-server"
printf '  llama-cli:    %s\n' "$PREFIX/bin/llama-cli"
printf '  quantize:     %s\n' "$PREFIX/bin/llama-quantize"
if [ -x "$PREFIX/bin/llama-server" ]; then
    "$PREFIX/bin/llama-server" --version 2>&1 | head -n 3 || true
fi
if [ -x "$VENV_DIR/bin/python" ]; then
    printf '  GGUF Python:  %s\n' "$VENV_DIR/bin/python"
    printf '  Convert HF:   llama-convert --outfile model.gguf --outtype q8_0 /path/to/hf-model\n'
fi
