# z/OS over SSH
term = xterm-256color
shell-integration-features = no-ssh-env,no-ssh-terminfo
copy-on-select = clipboard
scrollback-limit = 100000000
confirm-close-surface = false

window-height= 40
window-width= 120
window-padding-x = 10
window-padding-y = 10

font-family = Hack
font-size = 11.0

theme = Argonaut
background = #000000
foreground = #FFFFFF
background-opacity = 0.96
background-blur = 10

cursor-color = #E1E0DD
cursor-style-blink = true

mouse-scroll-multiplier = 10
