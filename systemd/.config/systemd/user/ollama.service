[Unit]
Description=Ollama Service (Native ROCm)
After=network-online.target

[Service]
# Installed by `make ollama` (build-ollama)
ExecStart=%h/.local/bin/ollama serve

# Standard model storage location
Environment="OLLAMA_MODELS=%h/.ollama/models"

# Required for KV cache quantization; keeps the fused FA kernel on HIP
Environment="OLLAMA_FLASH_ATTENTION=1"

# Symmetric K/V - halves cache footprint on 16 attention layers
Environment="OLLAMA_KV_CACHE_TYPE=q8_0"

# Unload after 5m idle; frees VRAM for the desktop compositor
Environment="OLLAMA_KEEP_ALIVE=5m"

# Stability settings
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
